# BSV Wallet Configuration (AUTO-GENERATED by setup script)
# These keys are generated by: npx tsx src/scripts/generate-keys.ts
MEDICAL_LICENSE_CERTIFIER=your_medical_license_certifier_key_here
PLATFORM_FUNDING_KEY=your_platform_funding_key_here
FEE_PER_KB=1

# Development Configuration
MOCK_UTXOS=false
NODE_ENV=development

# DID Configuration
DID_TOPIC=tm_did
DID_TOPIC_SERVICE=ls_did

# VC Configuration
VC_TOPIC=tm_vc
VC_TOPIC_SERVICE=ls_vc

# Docker network hostnames (DO NOT CHANGE for Docker deployment)
OVERLAY_PROVIDER_URL=http://overlay:8080

# Database Configuration (Docker network hostname)
MONGO_URI=mongodb://db-mongo:27017
MONGODB_URI=mongodb://db-mongo:27017
APP_DB_NAME=quarkid_prescriptions_db

# Server Configuration
PORT=3000

# Wallet Storage and DWN URL
WALLET_STORAGE_URL=https://storage.babbage.systems

# Debug mode
DEBUG=true
