# BlockMed Consolidated Environment Configuration
# This is the master .env template. Component .env files are symlinked to the root .env.
#
# Setup Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Run setup script: ./setup.sh
# 3. Keys will be auto-generated and symlinks created

# ============================================================================
# BSV Platform Configuration (REQUIRED)
# ============================================================================
# These will be auto-generated by setup.sh
# Or manually generate: cd back && npx tsx src/scripts/generate-keys.ts
MEDICAL_LICENSE_CERTIFIER=your_medical_license_certifier_key_here
PLATFORM_FUNDING_KEY=your_platform_funding_key_here
PLATFORM_FUNDING_ADDRESS=your_platform_funding_address_here
SERVER_PRIVATE_KEY=your_server_private_key_here

# ============================================================================
# ARC API Configuration (REQUIRED for BSV operations)
# ============================================================================
# Get your API key from: https://arc.taal.com/
ARC_API_KEY=mainnet_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Development Configuration
# ============================================================================
NODE_ENV=development
MOCK_UTXOS=false
DEBUG=true

# ============================================================================
# BSV Network Configuration
# ============================================================================
NETWORK=mainnet
FEE_PER_KB=1

# ============================================================================
# Wallet Storage Configuration (Backend only)
# ============================================================================
WALLET_STORAGE_URL=https://storage.babbage.systems
# Alternative: https://store-us-1.bsvb.tech
# Alternative: https://overlay-us-1.bsvb.tech

# ============================================================================
# Database Configuration
# ============================================================================
# Local development (used by back/.env)
MONGODB_URI=mongodb://localhost:27017
APP_DB_NAME=quarkid_prescriptions_db

# Docker network hostnames (used by docker-compose)
MONGO_URI=mongodb://db-mongo:27017
MYSQL_URL=mysql://overlayAdmin:overlay123@db-mysql:3306/overlay

# ============================================================================
# Service URLs
# ============================================================================
# Local development
OVERLAY_PROVIDER_URL=http://localhost:8080
HOSTING_URL=localhost:8080
PORT=3000

# Frontend API endpoint
VITE_API_URL=http://localhost:3000

# ============================================================================
# DID & VC Topic Configuration
# ============================================================================
DID_TOPIC=tm_did
DID_TOPIC_SERVICE=ls_did
VC_TOPIC=tm_vc
VC_TOPIC_SERVICE=ls_vc

# ============================================================================
# Overlay Service Configuration
# ============================================================================
REQUEST_LOGGING=true
GASP_SYNC=false
LOG_TIME=false
LOG_PREFIX=[LARS OVERLAY ENGINE]
THROW_ON_BROADCAST_FAIL=false
SYNC_CONFIG_JSON={}