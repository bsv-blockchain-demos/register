# BlockMed Docker Environment Configuration
# Copy this file to .env and update with your actual values

# BSV Platform Configuration (AUTO-GENERATED by setup script)
# These keys are generated by: cd back && npx tsx src/scripts/generate-keys.ts
MEDICAL_LICENSE_CERTIFIER=your_medical_license_certifier_key_here
PLATFORM_FUNDING_KEY=your_platform_funding_key_here
SERVER_PRIVATE_KEY=your_server_private_key_here

# ARC API Configuration (REQUIRED for BSV operations)
# Get your API key from: https://arc.taal.com/
# For testing, you can use: mainnet_testkey (limited functionality)
ARC_API_KEY=mainnet_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Development Configuration
NODE_ENV=development
MOCK_UTXOS=false

# BSV Network Configuration
NETWORK=mainnet
FEE_PER_KB=1

# Wallet Storage Configuration
WALLET_STORAGE_URL=https://store-us-1.bsvb.tech

# Database Configuration (Docker network hostnames)
MONGO_URI=mongodb://db-mongo:27017
MYSQL_URL=mysql://overlayAdmin:overlay123@db-mysql:3306/overlay

# Service URLs (Docker network hostnames)
OVERLAY_PROVIDER_URL=http://overlay:8080
HOSTING_URL=localhost:8080

# DID & VC Topic Configuration
DID_TOPIC=tm_did
DID_TOPIC_SERVICE=ls_did
VC_TOPIC=tm_vc
VC_TOPIC_SERVICE=ls_vc

# Overlay Service Configuration
REQUEST_LOGGING=true
GASP_SYNC=false
LOG_TIME=false
LOG_PREFIX=[LARS OVERLAY ENGINE]
THROW_ON_BROADCAST_FAIL=false
SYNC_CONFIG_JSON={}

# Frontend Configuration
VITE_API_URL=http://localhost:3000
VITE_WALLET_STORAGE_URL=https://storage.babbage.systems
